# ShortlistAI Root Environment Configuration Example

# Backend Configuration
APP_NAME=ShortlistAI
APP_ENV=development
DEBUG=false
DATABASE_URL=postgresql+asyncpg://shortlist:shortlist_dev@localhost:5434/shortlistai
JWT_SECRET_KEY=change-this-to-a-random-string-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO
SEED_RECRUITER_PASSWORD=
SEED_CLIENT_PASSWORD=
SEED_DELIVERY_PASSWORD=

# AI Provider Configuration (Phase 3)
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_REQUEST_TIMEOUT=30
AI_MAX_RETRIES=3

# Storage & Ingestion Configuration (Phase 4)
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=data/resumes
MAX_BATCH_FILES=500
MAX_FILE_SIZE_MB=15
MAX_BATCH_SIZE_MB=250

# Resume Worker Configuration (Phase 4)
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL=2.0
WORKER_JOB_TIMEOUT=180
WORKER_MAX_RETRIES=3

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

