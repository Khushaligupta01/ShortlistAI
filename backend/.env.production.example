# ShortlistAI Production Backend Environment Template
# Copy to .env in production deployment and populate with real secrets.
# NEVER commit the actual .env file or credentials to Git.

APP_NAME=ShortlistAI
APP_ENV=production
DEBUG=false

# PostgreSQL Database Connection URL (Must use postgresql+asyncpg driver)
DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@<db_host>:5432/<db_name>?ssl=require

# Cryptographic Secret Key for JWT Signing (Must be cryptographically random string >= 32 characters)
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-cryptographically-secure-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Production CORS & Frontend Allowed Origins (JSON array of valid origins)
CORS_ORIGINS=["https://app.shortlistai.com"]
FRONTEND_URL=https://app.shortlistai.com
LOG_LEVEL=INFO

# AI Provider Configuration
# Supported providers: openai, anthropic, gemini, fallback
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=sk-proj-YOUR_ACTUAL_PRODUCTION_API_KEY
AI_REQUEST_TIMEOUT=30
AI_MAX_RETRIES=3
AI_MAX_INPUT_TOKENS=4000
AI_MAX_OUTPUT_TOKENS=1000

# Private File Storage Configuration
# Local private storage volume or private cloud object storage mount
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT=/app/storage/private
MAX_RESUME_FILE_SIZE_BYTES=15728640
MAX_BATCH_FILES_COUNT=500
MAX_BATCH_SIZE_BYTES=262144000

# Persistent Background Worker Queue Configuration
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL_SECONDS=2.0
WORKER_LOCK_TIMEOUT_SECONDS=600
WORKER_MAX_ATTEMPTS=3

# Production Database Connection Pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

